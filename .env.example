# Server configuration
PORT=3000
HOST=0.0.0.0

# Cloudflare Edge Relay (Optional: Rotates global IPs via Cloudflare Worker for free)
# Deploy cloudflare_worker.js to Cloudflare Workers and put the URL here:
CLOUDFLARE_WORKER_URL=https://gemini-relay.example.workers.dev

# HTTP/HTTPS Proxy (Optional)
# HTTP_PROXY=http://user:pass@ip:port
# HTTPS_PROXY=http://user:pass@ip:port
